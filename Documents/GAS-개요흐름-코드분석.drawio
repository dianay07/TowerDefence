        <mxCell id="CCm-2qAUIBp0VJCvSnKO-92" value="Why 시점에서 하냐?" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="CCm-2qAUIBp0VJCvSnKO-91" vertex="1" connectable="0">
