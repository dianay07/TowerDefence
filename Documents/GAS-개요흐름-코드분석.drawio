          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-54" target="CCm-2qAUIBp0VJCvSnKO-76">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-97" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-54" target="CCm-2qAUIBp0VJCvSnKO-96">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-54" value="1. InstancedPerActor Ability 인스턴스 준비&#xa;2. GameplayEffect가 부여한 Ability라면 GE와 AbilityHandle 연결&#xa;3. GameplayTag / GameplayEvent 기반 Trigger 등록&#xa;4. Ability 자체의 OnGiveAbility() 콜백 호출" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="3462" y="1180" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-61" value="서버에서 GiveAbility()&#xa; -&gt; OnGiveAbility()&#xa; -&gt; MarkAbilitySpecDirty()&#xa; -&gt; 클라로 AbilitySpec 복제&#xa; -&gt; 클라 PostReplicatedAdd()&#xa; -&gt; 클라 OnGiveAbility()" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="3462" y="1330" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-62" value="&lt;pre&gt;동기화 관점.&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="3460" y="1290" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-63" value="&lt;pre&gt;핵심역활 4가지&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="3460" y="1140" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-68" target="CCm-2qAUIBp0VJCvSnKO-69">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-68" value="// GameplayAbilityTypes.h&#xa;namespace EGameplayAbilityInstancingPolicy&#xa;{&#xa;    enum Type : int&#xa;    {&#xa;        // 인스턴스를 만들지 않고 Ability CDO에서 실행&#xa;        // UE5.5 기준 Deprecated 성격&#xa;        NonInstanced,&#xa;&#xa;&#xa;        // Actor/ASC 하나당 Ability 인스턴스 하나를 생성&#xa;        // 같은 Ability가 여러 번 발동되어도 같은 인스턴스를 재사용&#xa;        InstancedPerActor,&#xa;&#xa;&#xa;        // Ability 실행할 때마다 새 인스턴스 생성&#xa;        // 동시에 여러 실행이 필요할 때 사용&#xa;        InstancedPerExecution,&#xa;    };&#xa;}" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="4470" y="730" width="360" height="310" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-69" target="CCm-2qAUIBp0VJCvSnKO-72">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-69" value="장점:&#xa;- Ability 안에 멤버 변수 상태를 가질 수 있음&#xa;- OnGiveAbility(), OnAvatarSet() 같은 콜백에서 초기화 가능&#xa;- Ability 내부 RPC / 복제 인스턴스 흐름에 유리&#xa;- 같은 Actor가 가진 Ability 상태를 유지할 수 있음&#xa;&#xa;&#xa;주의:&#xa;- 같은 Ability가 동시에 여러 개 실행되는 구조에는 부적합&#xa;- 이전 실행의 상태가 다음 실행에 남을 수 있음&#xa;- activation마다 독립 상태가 필요하면 InstancedPerExecution이 더 맞음" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="4942" y="730" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-72" target="CCm-2qAUIBp0VJCvSnKO-73">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-72" value="예를 들면 이런 경우 InstancedPerActor가 적당해.&#xa;&#xa;패시브 스킬&#xa;토글 스킬&#xa;캐릭터가 항상 들고 있는 기본 공격&#xa;타워의 기본 공격 Ability&#xa;쿨다운/상태를 Ability 인스턴스 안에서 관리하는 스킬" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="4992" y="950" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-73" value="반대로 이런 경우는 InstancedPerExecution을 고려해야 해.&#xa;동시에 여러 번 겹쳐 실행되는 스킬&#xa;각 실행마다 독립 TargetData / Task / 상태가 필요한 스킬&#xa;차징 중 여러 발을 동시에 관리하는 스킬" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="4982" y="1115" width="320" height="95" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-76" target="CCm-2qAUIBp0VJCvSnKO-79">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-76" value="&lt;span style=&quot;color: rgb(51, 51, 51); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;GameplayEffect&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="3882" y="1210" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-79" target="CCm-2qAUIBp0VJCvSnKO-82">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-79" value="UGameplayEffect&#xa;= 효과의 설계도 / 에셋 / 클래스&#xa;&#xa;&#xa;FGameplayEffectSpec&#xa;= 이번에 적용할 효과 데이터&#xa;= 레벨, SetByCaller, Source, Target 정보 포함&#xa;&#xa;&#xa;FActiveGameplayEffect&#xa;= ASC에 실제로 적용되어 살아있는 효과 인스턴스&#xa;= 버프, 디버프, 지속효과, 무한 지속 효과 등" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="4060" y="1175" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-82" target="CCm-2qAUIBp0VJCvSnKO-84">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-82" value="GE_Poison&#xa;= 독 효과 정의&#xa;&#xa;&#xa;FGameplayEffectSpec&#xa;= 5초짜리 독, 초당 10 데미지, 시전자 A&#xa;&#xa;&#xa;FActiveGameplayEffect&#xa;= Enemy ASC에 실제로 걸려 있는 독 효과&#xa;= 시작 시간, 남은 시간, 스택, Handle, Spec 등을 가짐" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="4050" y="1415" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-84" value="&lt;code&gt;Active Gameplay Effect&lt;/code&gt;는 단순히 “GE 클래스”가 아니라, &lt;strong&gt;ASC 안에 현재 걸려있는 런타임 효과&lt;/strong&gt;야." style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="3935" y="1625" width="530" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-90" target="CCm-2qAUIBp0VJCvSnKO-87">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3120" y="1430" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-86" value="&lt;span style=&quot;color: rgb(51, 51, 51);&quot;&gt;2. GameplayEffect가 부여한 Ability라면 GE와 AbilityHandle 연결하는 코드가 있는데&amp;nbsp;&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="2910" y="1280" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-87" value="이미 ASC에 들어온 AbilitySpec을 보고&#xa;그 Ability를 부여한 ActiveGameplayEffect 쪽에 역참조 정보를 기록하는 후처리" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="2930" y="1440" width="430" height="50" as="geometry" />
        </mxCell>
