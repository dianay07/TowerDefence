          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="[HandleGameplayEvent (line 2530)](C:/AAA_P/Engine/UnrealEngine/Engine/Plugins/Runtime/GameplayAbilities&lt;br&gt;/Source/GameplayAbilities/Private/AbilitySystemComponent_Abilities.cpp:2530)는 이런 식으로 동작해." link="[HandleGameplayEvent (line 2530)](C:/AAA_P/Engine/UnrealEngine/Engine/Plugins/Runtime/GameplayAbilities/Source/GameplayAbilities/Private/AbilitySystemComponent_Abilities.cpp:2530)는 이런 식으로 동작해." id="CCm-2qAUIBp0VJCvSnKO-112">
