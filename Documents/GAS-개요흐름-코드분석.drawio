          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-99" value="GrantedAbilityHandles 처리 하는 코드가 있는데, 인자로온 AbilitySpec 이 This 와 연결되어 있다라는 기록을 한다.&amp;nbsp;" style="text;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="2440" y="1200" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-101" value="Event.Damage.Fire&#xa; -&gt; 부모: Event.Damage&#xa; -&gt; 부모: Event" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="4480" y="1220" width="160" height="70" as="geometry" />
