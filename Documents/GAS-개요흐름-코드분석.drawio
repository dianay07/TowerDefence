          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3120" y="1430" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-86" value="&lt;span style=&quot;color: rgb(51, 51, 51);&quot;&gt;2. GameplayEffect가 부여한 Ability라면 GE와 AbilityHandle 연결하는 코드가 있는데&amp;nbsp;&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="2910" y="1280" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-87" value="이미 ASC에 들어온 AbilitySpec을 보고&#xa;그 Ability를 부여한 ActiveGameplayEffect 쪽에 역참조 정보를 기록하는 후처리" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="2930" y="1440" width="430" height="50" as="geometry" />
