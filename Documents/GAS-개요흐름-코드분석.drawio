        <mxCell id="CCm-2qAUIBp0VJCvSnKO-103" value="Tag 처리 하는 코드를 설명하면&lt;br&gt;“이 Ability가 어떤 GameplayTag에 의해 자동 발동될 수 있는지 ASC 안에 등록한다.”" style="text;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="2430" y="1530" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-106" value="&lt;span style=&quot;color: rgb(51, 51, 51);&quot;&gt;3. GameplayTag / GameplayEvent 기반 Trigger 등록&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="2930" y="1540" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-107" value="&lt;font face=&quot;monospace&quot;&gt;등록 시점에 Tag 에 Handle 을 저장&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="2930" y="1595" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-108" value="ASC::HandleGameplayEvent(EventTag, Payload)&#xa; -&gt; GameplayEventTriggeredAbilities에서 EventTag 검색&#xa; -&gt; 등록된 AbilitySpecHandle 목록 획득&#xa; -&gt; TriggerAbilityFromGameplayEvent()&#xa; -&gt; InternalTryActivateAbility()" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="2920" y="1730" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-108" target="CCm-2qAUIBp0VJCvSnKO-108">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-110" value="즉 구조는 이렇게 됨.&#xa;GameplayEventTriggeredAbilities&#xa;{&#xa;    Event.Hit -&gt; [AbilitySpecHandle_A, AbilitySpecHandle_B]&#xa;}&#xa;&#xa;&#xa;OwnedTagTriggeredAbilities&#xa;{&#xa;    State.Stunned -&gt; [AbilitySpecHandle_C]&#xa;}" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="2910" y="2000" width="350" height="170" as="geometry" />
