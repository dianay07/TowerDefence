        <mxCell id="CCm-2qAUIBp0VJCvSnKO-9" value="&lt;pre&gt;&lt;code&gt;UAbilitySystemComponent::InitAbilityActorInfo&lt;/code&gt;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1850" y="510" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-12" target="CCm-2qAUIBp0VJCvSnKO-17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-12" value="&lt;pre&gt;&lt;code&gt;FGameplayAbilityActorInfo::InitFromActor&lt;/code&gt;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1970" y="610" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-17" value="&lt;pre&gt;OwnerActor&lt;br&gt; -&amp;gt; AbilitySystemComponent를 논리적으로 소유하는 Actor&lt;br&gt;&lt;br&gt;AvatarActor&lt;br&gt; -&amp;gt; 실제 월드에서 움직이고, 맞고, 애니메이션을 재생하는 Actor&lt;br&gt;&lt;br&gt;를 지정 또한  AvatarActor와 연결된 Controller, Mesh, MovementComponent는 무엇인가?&lt;br/&gt;지정 하는 함수&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="2320" y="665" width="510" height="120" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-19" target="CCm-2qAUIBp0VJCvSnKO-21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-19" value="InitAbilityActorInfo()&#xa; -&gt; AbilityActorInfo에 Owner / Avatar / ASC 등록&#xa; -&gt; PlayerController, Mesh, MovementComponent 캐싱&#xa; -&gt; ASC 내부 OwnerActor / AvatarActor 갱신&#xa; -&gt; 밀린 GameplayCue 처리&#xa; -&gt; Avatar가 바뀌었으면 Ability들에게 OnAvatarSet 호출&#xa; -&gt; GameplayTag Response 등록&#xa; -&gt; Montage 관련 정보 초기화" style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="2450" y="445" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.005;entryY=0.452;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-9" target="CCm-2qAUIBp0VJCvSnKO-19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-21" target="CCm-2qAUIBp0VJCvSnKO-23" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-21" value="&lt;code&gt;AvatarActor&lt;/code&gt;가 바뀌는 대표적인 경우는 &lt;strong&gt;ASC를 가진 객체와 실제 몸체 Actor가 분리되어 있을 때&lt;/strong&gt;야." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="2850" y="470" width="530" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-23" target="CCm-2qAUIBp0VJCvSnKO-24" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-23" target="CCm-2qAUIBp0VJCvSnKO-29" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-23" value="예를 들어 RPG에서 많이 쓰는 구조:&#xa;OwnerActor = PlayerState&#xa;AvatarActor = Character" style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="3240" y="535" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-24" target="CCm-2qAUIBp0VJCvSnKO-25" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-24" value="플레이어가 죽고 리스폰하면:PlayerState는 유지&#xa;기존 Character는 Destroy&#xa;새 Character Spawn" style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="3360" y="595" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-25" value="그러면 ASC는 계속 PlayerState에 남아 있고, AvatarActor만 새 Character로 바뀐다.ASC-&gt;InitAbilityActorInfo(PlayerState, NewCharacter);" style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="3480" y="680" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-29" value="1. 플레이어 사망 후 리스폰&#xa;OwnerActor = PlayerState 유지&#xa;AvatarActor = OldCharacter -&gt; NewCharacter&#xa;&#xa;&#xa;2. 캐릭터 교체&#xa;전사 캐릭터에서 마법사 캐릭터로 교체&#xa;AvatarActor가 새 Pawn/Character로 변경&#xa;&#xa;&#xa;3. 빙의 대상 변경&#xa;PlayerController가 다른 Pawn을 Possess&#xa;ASC Owner는 유지하고 실제 조작 Pawn만 변경&#xa;&#xa;&#xa;4. 탈것 탑승&#xa;평소 AvatarActor = Character&#xa;탑승 중 AvatarActor = Vehicle 또는 탑승용 Pawn&#xa;&#xa;&#xa;5. 변신 시스템&#xa;인간 Character -&gt; 늑대 Character 같은 별도 Actor로 교체&#xa;&#xa;&#xa;6. 영구 계정/플레이어 상태는 유지하고 몸체만 계속 교체하는 구조" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="3890" y="410" width="360" height="380" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-32" value="ASC에게 “내 주인은 누구고, 실제 몸체는 누구인지” 알려주고, Ability 실행에 필요한 Controller/Mesh/Movement 정보를 준비하는 함수." style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="2450" y="585" width="430" height="50" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-33" target="CCm-2qAUIBp0VJCvSnKO-34" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-33" target="CCm-2qAUIBp0VJCvSnKO-44" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-33" target="CCm-2qAUIBp0VJCvSnKO-36" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-47" value="내부 함수 호출" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="CCm-2qAUIBp0VJCvSnKO-46" vertex="1" connectable="0">
          <mxGeometry x="-0.2441" y="-5" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-33" value="&lt;span style=&quot;color: rgb(51, 51, 51); text-align: left;&quot;&gt;UAbilitySystemComponent::GiveAbility&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1710" y="880" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-34" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font color=&quot;#333333&quot;&gt;Client 에서는 작동 안함&lt;br&gt;&lt;/font&gt;&lt;/span&gt;클라이언트는 서버가 부여한 AbilitySpec을 복제로 받는 쪽이다.&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font color=&quot;#333333&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="2068" y="830" width="342" height="50" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-36" target="CCm-2qAUIBp0VJCvSnKO-38" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-36" target="CCm-2qAUIBp0VJCvSnKO-49" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-36" value="&lt;span style=&quot;color: rgb(51, 51, 51); text-align: left;&quot;&gt;UAbilitySystemComponent::OnGiveAbility&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1800" y="1045" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-38" target="CCm-2qAUIBp0VJCvSnKO-42" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-38" value="&lt;code&gt;GiveAbility()&lt;/code&gt;는 Ability를 실행하는 함수가 아니라, &lt;strong&gt;ASC에 Ability를 등록하는 함수&lt;/strong&gt;다." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="2150" y="1045" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-42" value="GiveAbility()&#xa; = Ability를 배운다 / 장착한다 / ASC의 ActivatableAbilities 목록에 추가한다&#xa;&#xa;&#xa;TryActivateAbility()&#xa; = 등록된 Ability를 실제로 발동한다" style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="2670" y="975" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-44" value="&lt;div style=&quot;text-align: left;&quot;&gt;ASC에 &lt;strong&gt;사용 가능한 GameplayAbility를 등록하는 함수&lt;/strong&gt;야.&lt;br&gt;즉 “스킬을 배운다 / 타워에게 공격 Ability를 준다 / 캐릭터에게 Dash Ability를 준다” 같은 의미로 보면 된다.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="2068" y="890" width="392" height="70" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-48" value="&lt;span style=&quot;color: rgb(51, 51, 51); text-align: left;&quot;&gt;MarkAbilitySpecDirty&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1790" y="1300" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-49" target="CCm-2qAUIBp0VJCvSnKO-51" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-49" value="&lt;pre&gt;&lt;code&gt;UGameplayAbility::OnGiveAbility&lt;/code&gt;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1900" y="1140" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-51" target="CCm-2qAUIBp0VJCvSnKO-63" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-51" value="&lt;code&gt;OnGiveAbility()&lt;/code&gt;는 Ability를 “주는 함수”가 아니라, &lt;strong&gt;부여된 Ability를 GAS 시스템에 연결하는 후처리 함수&lt;/strong&gt;다." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="2440" y="1140" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-54" target="CCm-2qAUIBp0VJCvSnKO-62" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-54" target="CCm-2qAUIBp0VJCvSnKO-76" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-97" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-54" target="CCm-2qAUIBp0VJCvSnKO-96" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-54" value="1. InstancedPerActor Ability 인스턴스 준비&#xa;2. GameplayEffect가 부여한 Ability라면 GE와 AbilityHandle 연결&#xa;3. GameplayTag / GameplayEvent 기반 Trigger 등록&#xa;4. Ability 자체의 OnGiveAbility() 콜백 호출" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="3462" y="1180" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-61" value="서버에서 GiveAbility()&#xa; -&gt; OnGiveAbility()&#xa; -&gt; MarkAbilitySpecDirty()&#xa; -&gt; 클라로 AbilitySpec 복제&#xa; -&gt; 클라 PostReplicatedAdd()&#xa; -&gt; 클라 OnGiveAbility()" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="3462" y="1330" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-62" value="&lt;pre&gt;동기화 관점.&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="3460" y="1290" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-63" value="&lt;pre&gt;핵심역활 4가지&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="3460" y="1140" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-68" target="CCm-2qAUIBp0VJCvSnKO-69" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-68" value="// GameplayAbilityTypes.h&#xa;namespace EGameplayAbilityInstancingPolicy&#xa;{&#xa;    enum Type : int&#xa;    {&#xa;        // 인스턴스를 만들지 않고 Ability CDO에서 실행&#xa;        // UE5.5 기준 Deprecated 성격&#xa;        NonInstanced,&#xa;&#xa;&#xa;        // Actor/ASC 하나당 Ability 인스턴스 하나를 생성&#xa;        // 같은 Ability가 여러 번 발동되어도 같은 인스턴스를 재사용&#xa;        InstancedPerActor,&#xa;&#xa;&#xa;        // Ability 실행할 때마다 새 인스턴스 생성&#xa;        // 동시에 여러 실행이 필요할 때 사용&#xa;        InstancedPerExecution,&#xa;    };&#xa;}" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="4470" y="730" width="360" height="310" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-69" target="CCm-2qAUIBp0VJCvSnKO-72" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-69" value="장점:&#xa;- Ability 안에 멤버 변수 상태를 가질 수 있음&#xa;- OnGiveAbility(), OnAvatarSet() 같은 콜백에서 초기화 가능&#xa;- Ability 내부 RPC / 복제 인스턴스 흐름에 유리&#xa;- 같은 Actor가 가진 Ability 상태를 유지할 수 있음&#xa;&#xa;&#xa;주의:&#xa;- 같은 Ability가 동시에 여러 개 실행되는 구조에는 부적합&#xa;- 이전 실행의 상태가 다음 실행에 남을 수 있음&#xa;- activation마다 독립 상태가 필요하면 InstancedPerExecution이 더 맞음" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="4942" y="730" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-72" target="CCm-2qAUIBp0VJCvSnKO-73" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-72" value="예를 들면 이런 경우 InstancedPerActor가 적당해.&#xa;&#xa;패시브 스킬&#xa;토글 스킬&#xa;캐릭터가 항상 들고 있는 기본 공격&#xa;타워의 기본 공격 Ability&#xa;쿨다운/상태를 Ability 인스턴스 안에서 관리하는 스킬" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="4992" y="950" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-73" value="반대로 이런 경우는 InstancedPerExecution을 고려해야 해.&#xa;동시에 여러 번 겹쳐 실행되는 스킬&#xa;각 실행마다 독립 TargetData / Task / 상태가 필요한 스킬&#xa;차징 중 여러 발을 동시에 관리하는 스킬" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="4982" y="1115" width="320" height="95" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-76" target="CCm-2qAUIBp0VJCvSnKO-79" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-76" value="&lt;span style=&quot;color: rgb(51, 51, 51); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;GameplayEffect&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="3882" y="1210" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-79" target="CCm-2qAUIBp0VJCvSnKO-82" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-79" value="UGameplayEffect&#xa;= 효과의 설계도 / 에셋 / 클래스&#xa;&#xa;&#xa;FGameplayEffectSpec&#xa;= 이번에 적용할 효과 데이터&#xa;= 레벨, SetByCaller, Source, Target 정보 포함&#xa;&#xa;&#xa;FActiveGameplayEffect&#xa;= ASC에 실제로 적용되어 살아있는 효과 인스턴스&#xa;= 버프, 디버프, 지속효과, 무한 지속 효과 등" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="4060" y="1175" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="CCm-2qAUIBp0VJCvSnKO-82" target="CCm-2qAUIBp0VJCvSnKO-84" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-82" value="GE_Poison&#xa;= 독 효과 정의&#xa;&#xa;&#xa;FGameplayEffectSpec&#xa;= 5초짜리 독, 초당 10 데미지, 시전자 A&#xa;&#xa;&#xa;FActiveGameplayEffect&#xa;= Enemy ASC에 실제로 걸려 있는 독 효과&#xa;= 시작 시간, 남은 시간, 스택, Handle, Spec 등을 가짐" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="4050" y="1415" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-84" value="&lt;code&gt;Active Gameplay Effect&lt;/code&gt;는 단순히 “GE 클래스”가 아니라, &lt;strong&gt;ASC 안에 현재 걸려있는 런타임 효과&lt;/strong&gt;야." style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="3935" y="1625" width="530" height="40" as="geometry" />
        </mxCell>
