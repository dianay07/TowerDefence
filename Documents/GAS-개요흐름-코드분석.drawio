            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-90" value="&lt;code&gt;OnGiveAbility()&lt;/code&gt;에서 하냐면, 이 시점이 &lt;strong&gt;Ability 부여가 실제로 성공한 뒤&lt;/strong&gt;이기 때문이야." style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="2910" y="1365" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="CCm-2qAUIBp0VJCvSnKO-98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CCm-2qAUIBp0VJCvSnKO-96" target="CCm-2qAUIBp0VJCvSnKO-68">
          <mxGeometry relative="1" as="geometry" />
