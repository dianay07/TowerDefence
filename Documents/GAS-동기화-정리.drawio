          <mxGeometry x="270" y="1570" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-22" value="GE Modifier 하나를 실제 AttributeSet 값 변경으로 연결하는 핵심 함수야. &lt;code&gt;PreGameplayEffectExecute()&lt;/code&gt;로 적용 가능 여부를 확인하고, &lt;code&gt;ApplyModToAttribute()&lt;/code&gt;로 실제 값을 바꾼 뒤, &lt;code&gt;PostGameplayEffectExecute()&lt;/code&gt;로 후처리를 호출한다. 이 함수 자체가 네트워크 패킷을 보내지는 않고, 서버에서 바뀐 Attribute 결과가 이후 Replication으로 클라이언트에 전달된다." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="740" y="1580" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-25" target="Vepwqi47QPS1BIdAyWZW-31" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-25" target="Vepwqi47QPS1BIdAyWZW-34" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-25" value="&lt;code&gt;FActiveGameplayEffectsContainer::ApplyModToAttribute&lt;/code&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="440" y="1740" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-28" target="Vepwqi47QPS1BIdAyWZW-29" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-28" value="&lt;code&gt;FGameplayModifierEvaluatedData&lt;/code&gt; 간단 설명" style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="1440" y="1037.25" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-29" value="이 객체는 &lt;strong&gt;계산이 끝난 Modifier 한 줄&lt;/strong&gt;이야.&lt;br&gt;GE는 여러 설정 값들이 있는데 이를 동일한 방법으로 처리 해줄 수 있게 사용되는 객체" style="text;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1750" y="1031.75" width="250" height="51" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-31" value="&lt;strong&gt;실행 가능한 형태로 계산이 끝난 Modifier 데이터&lt;/strong&gt;고, &lt;code&gt;ApplyModToAttribute()&lt;/code&gt;는 그 데이터를 받아 &lt;strong&gt;현재 BaseValue에 연산을 적용해서 실제 Attribute 값을 바꾸는 함수&lt;/strong&gt;야." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="900" y="1790" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-34" value="Attribute 값을 가져와서 , 계산하고 이를 set 한다." style="text;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="900" y="1740" width="250" height="31" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-36" target="Vepwqi47QPS1BIdAyWZW-38" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-36" target="Vepwqi47QPS1BIdAyWZW-50" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-54" value="내부 함수" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="Vepwqi47QPS1BIdAyWZW-51" vertex="1" connectable="0">
          <mxGeometry x="-0.3986" y="3" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-36" value="&lt;code&gt;FActiveGameplayEffectsContainer::SetAttributeBaseValue&lt;/code&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="630" y="1880" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.526;entryY=0.025;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-25" target="Vepwqi47QPS1BIdAyWZW-36" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-38" value="계산된 &lt;code&gt;NewBaseValue&lt;/code&gt;를 AttributeSet의 BaseValue에 반영하는 함수야. 변경 전에는 &lt;code&gt;PreAttributeBaseChange()&lt;/code&gt;로 Clamp 기회를 주고, Aggregator가 있으면 Aggregator를 통해 최종값을 갱신하며, 없으면 &lt;code&gt;InternalUpdateNumericalAttribute()&lt;/code&gt;로 실제 Attribute 값을 바로 바꾼다." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="1100" y="1870" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-40" target="Vepwqi47QPS1BIdAyWZW-41" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-40" value="FAggregator 간단 설명" style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="1441" y="1108.25" width="189" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-41" value="&lt;strong&gt;Attribute의 최종값을 계산하는 계산기&lt;/strong&gt;라고 보면 돼." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="1750" y="1108.25" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-43" value="BaseValue 저장&#xa;ActiveGE Modifier 저장&#xa;Add / Multiply / Divide / Override 계산&#xa;Modifier 추가/제거 시 재계산&#xa;값이 바뀌면 OnDirty 이벤트 발생" style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="1750" y="1168.25" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-44" value="&lt;code&gt;FAggregator&lt;/code&gt;가 중간에서 “현재 Attribute 값은 여러 효과를 합산하면 얼마인가?”를 계산해준다." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="1750" y="1278.25" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-45" value="&lt;code&gt;AttributeAggregatorMap&lt;/code&gt;은 Attribute마다 그 계산기를 저장하는 맵이야. 이 구조가 있어야 GAS가 버프, 디버프, 지속 효과, 예측, 복제 보정을 한 Attribute 값에 안정적으로 합산할 수 있어." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="1740" y="1350" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-46" target="Vepwqi47QPS1BIdAyWZW-45" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-46" value="&lt;code&gt;AttributeAggregatorMap&lt;/code&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="1440" y="1355" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-50" target="Vepwqi47QPS1BIdAyWZW-52" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-50" target="Vepwqi47QPS1BIdAyWZW-55" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-50" value="&lt;code&gt;FActiveGameplayEffectsContainer::InternalUpdateNumericalAttribute&lt;/code&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="795" y="2000" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-52" target="Vepwqi47QPS1BIdAyWZW-59" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-52" value="&lt;strong&gt;계산된 최종 Attribute 값을 실제 AttributeSet에 쓰고, Attribute 변경 Delegate를 Broadcast하는 함수&lt;/strong&gt;야." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="1270" y="2000" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-55" target="Vepwqi47QPS1BIdAyWZW-57" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-55" value="&lt;code&gt;FActiveGameplayEffectsContainer::SetNumericAttribute_Internal&lt;/code&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="975" y="2090" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-57" value="&lt;code&gt;FGameplayAttribute::SetNumericValueChecked&lt;/code&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="1070" y="2170" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-59" value="GAS Attribute 변경 흐름의 마지막 실무 처리 지점이야. &lt;code&gt;Owner-&amp;gt;SetNumericAttribute_Internal()&lt;/code&gt;로 실제 AttributeSet 값을 바꾸고, &lt;code&gt;AttributeValueChangeDelegates&lt;/code&gt;를 통해 UI나 AbilityTask가 반응할 수 있게 알린다. 서버에서는 이 변경이 이후 복제로 클라이언트에 전달되고, 클라이언트에서는 복제 수신 후 로컬 값과 UI를 갱신하는 데 사용된다." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="1880" y="1985" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-61" target="Vepwqi47QPS1BIdAyWZW-68" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-61" value="&lt;strong&gt;AttributeSet 안의 실제 Attribute 값을 쓰는 함수&lt;/strong&gt;야." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="1510" y="2170" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.018;entryY=0.454;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-57" target="Vepwqi47QPS1BIdAyWZW-61" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-63" target="Vepwqi47QPS1BIdAyWZW-64" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-63" value="MARK_PROPERTY_DIRTY(Dest, StructProperty);" style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="1510" y="2220" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="Vepwqi47QPS1BIdAyWZW-64" target="Vepwqi47QPS1BIdAyWZW-66" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-64" value="이 Property가 변경됐다" style="text;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1850" y="2230" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-66" value="SetNumericValueChecked()&#xa; -&gt; Property Dirty 표시&#xa; -&gt; 이후 Replication 시스템이 변경분을 클라이언트에 보냄" style="text;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="1760" y="2290" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Vepwqi47QPS1BIdAyWZW-68" value="&lt;code&gt;FGameplayAttribute&lt;/code&gt;가 가리키는 실제 AttributeSet 멤버를 Reflection으로 찾아서 값을 쓰는 함수야. &lt;code&gt;FGameplayAttributeData&lt;/code&gt;라면 &lt;code&gt;CurrentValue&lt;/code&gt;를 바꾸고, raw float 계열이면 해당 float 값을 직접 바꾼다. 값 변경 전후로 &lt;code&gt;PreAttributeChange()&lt;/code&gt; / &lt;code&gt;PostAttributeChange()&lt;/code&gt;를 호출하고, 마지막에 &lt;code&gt;MARK_PROPERTY_DIRTY&lt;/code&gt;로 복제 변경 대상임을 표시한다." style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="2030" y="2150" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6alcSkaxHUqKtO2FJsU3-1" value="[초기 1회성 구성]&#xa;GetLifetimeReplicatedProps()&#xa; -&gt; OutLifetimeProps에 복제 Property 등록&#xa; -&gt; FRepLayout 생성 / 캐싱&#xa;&#xa;&#xa;[매 Replication Tick]&#xa;ActorChannel&#xa; -&gt; FObjectReplicator&#xa; -&gt; FRepLayout&#xa; -&gt; 등록된 Property 중 변경된 값 확인&#xa; -&gt; 조건 맞으면 Bunch에 기록&#xa; -&gt; 클라이언트로 송신" style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="220" y="2280" width="250" height="210" as="geometry" />
        </mxCell>
        <mxCell id="0u9LB9DGlWx94DoJVVMW-3" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;editableCssRules=.*;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="827" y="2440" width="1200" height="880" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
