<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/27.0.9 Chrome/134.0.6998.205 Electron/35.4.0 Safari/537.36" version="27.0.9">
  <diagram name="페이지-1" id="SDnKvEwGEQ2BF1tVjAzU">
    <mxGraphModel dx="1968" dy="1176" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-1" value="멀티플레이어 게임 프로그래밍 문서 정리" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="30" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-2" value="Actor Replication Flow" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="180" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-3" value="Replication 을 복제로 번역하지만, ai 대답상 동기화에 가깝다고함 정확한건 코드를 봐야 할 것 같음" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="380" y="180" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="47_Y47ZIK-oFz3ixZD5e-4" target="47_Y47ZIK-oFz3ixZD5e-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-4" value="&lt;strong&gt;복제 중인 모든 Actor를 순회합니다&lt;/strong&gt; (&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;AActor::SetReplicates(true)&lt;/code&gt; 상태인 것들)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="980" y="940" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-6" value="얼마나 자주 리플리케이션 될지 결정" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1390" y="960" width="215" height="60" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-8" value="해당 Actor가 초기 휴면 상태(&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&lt;b&gt;DORM_Initial&lt;/b&gt;&lt;/code&gt;)인지 확인하고, 그렇다면 즉시 건너뜁니다." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="980" y="1040" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-9" value="&lt;b&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;NetUpdateFrequency&lt;/code&gt; &lt;/b&gt;값을 확인하여 업데이트가 필요한지 결정합니다. 불필요하면 건너뜁니다." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="980" y="1140" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-10" value="&lt;b&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;AActor::bOnlyRelevantToOwner&lt;/code&gt;가 true이면, &lt;/b&gt;소유 커넥션의 뷰어를 대상으로 &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;AActor::IsRelevancyOwnerFor&lt;/code&gt;를 호출하여 관련성을 확인합니다. 관련이 있으면 해당 커넥션의 소유 관련 목록에 추가합니다. 이 경우 Actor는 단 하나의 커넥션에만 전송됩니다." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="980" y="1240" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-11" value="&lt;b&gt;초기 검사를 통과한 Actor에 대해 &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;AActor::PreReplication&lt;/code&gt;이 호출&lt;/b&gt;됩니다. 이 함수는 특정 커넥션에 프로퍼티를 복제할지 여부를 결정하는 곳입니다. &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;DOREPLIFETIME_ACTIVE_OVERRIDE&lt;/code&gt;를 사용하세요." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="985" y="1420" width="305" height="110" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-12" value="&lt;p class=&quot;font-claude-response-body break-words whitespace-normal leading-[1.7]&quot;&gt;Actor 복제는 Network Driver(Net Driver)가 어떤 Actor를 어떤 커넥션에 어떤 순서로 복제할지 결정하는 상세하고 다단계적인 프로세스입니다. 이 페이지에서는 Actor 복제 프로세스에 대한 개요를 제공합니다.&lt;/p&gt;&lt;br&gt;&lt;p class=&quot;font-claude-response-body break-words whitespace-normal leading-[1.7]&quot;&gt;Actor 복제의 대부분은 &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;U&lt;b&gt;NetDriver::ServerReplicateActors&lt;/b&gt;&lt;/code&gt;&lt;b&gt; &lt;/b&gt;함수 내부에서 이루어집니다. 이 함수에서 서버는 각 클라이언트에 관련성이 있다고 판단한 모든 Actor를 먼저 수집한 뒤, 마지막으로 각 연결된 클라이언트가 업데이트된 이후 변경된 프로퍼티를 전송합니다. 그런 다음&lt;b&gt; &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;UActorChannel::ReplicateActor&lt;/code&gt;&lt;/b&gt; 함수가 특정 채널로의 Actor 복제 세부 사항을 처리합니다.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="270" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-13" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="75" y="520" width="757" height="424" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-14" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="75" y="1000" width="725" height="377" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-15" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="69" y="1430" width="737" height="573" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-16" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="71" y="2040" width="735" height="518" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-17" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="75" y="2600" width="735" height="490" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-18" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="75" y="3090" width="722" height="437" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-19" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="75" y="3527" width="738" height="442" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-20" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="75" y="3969" width="706" height="346" as="geometry" />
        </mxCell>
        <mxCell id="47_Y47ZIK-oFz3ixZD5e-21" value="&lt;b&gt;서버의 작동 원리&lt;/b&gt;&lt;div&gt;&lt;b&gt;1. 액터 네트워크 휴면 상태 기능이 있고, 일시정지 및 강제 Tick 기능 등이 있다.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2.리플리케이트된 엑터는 서버와 클라이언트에 동시에 존재, 플레이어는 클라이언트 컨트롤러에 빙의 되어 사용이 되며, 빙이되면 소유자는 서로 연관성이 있게된다.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;3.&amp;nbsp; Actor 별로 Role 을 지정할 수 있는데 , 서버에서만 실행 하는지 , 클라에서만 작동하는지 등등 지정 가능&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4. 리플레케이션 서버는 거리기반으로 Relevancy 로 Actor 간의 연관성을 지을 수 있다.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;5. 업데이트 빈도 변경 가능&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="950" y="1644" width="590" height="156" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="140" y="4750" width="810" height="249.75" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-2" value="게임 인스턴스는 서버이자 클라이언트 역할을 모두 수행한다.&amp;nbsp;&lt;div&gt;싱글 플레이어로 구성시에는 다른 클라언트가 접속 할 수 없다.&lt;/div&gt;&lt;div&gt;Listen 옵션으로 추가 하면 수신 서버로 실행 됩니다. 다른 게임 인스턴스가 클라리언트로 연결이 됨.&lt;/div&gt;&lt;div&gt;데디케이드 ( 전용서버 )&amp;nbsp; - 서버 전용 콘솔 애플리케이션 이다.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="150" y="5080" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-3" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="130" y="5310" width="770" height="309.28" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-4" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="122" y="5790" width="710" height="426" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-5" value="Net 붙은 친구들 UChannel 은 백그라운드에서 작동한다" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="130" y="5700" width="450" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-6" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="85" y="6280" width="900" height="512.25" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-7" value="InitListen" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1040" y="6570" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-8" value="서버가 생성되면 UNetDrive 가 생성 ( InitListen 함수 확인 ) , 클라이언트가 생성되면 UNetDirve 각각 생성되고 이들이 연결이 된다.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1020" y="6220" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-9" value="UNetDirve 연결이 되면 UNetConnection 이 생성이 된다.&lt;br&gt;각 채널들이 생성되는데 , 이미지와 참고&amp;nbsp;&lt;br&gt;Actor 채널은 동기화를 위해 복제되는 체널이다." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1020" y="6310" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-11" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="50" y="6870" width="950" height="492.42" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-12" value="* 액터의 수명 - 서버와 클라이언트 간에 동기화 됩니다.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="7510" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-13" value="리플레케이션 속성이 켜저 있다면 , 서버에서 값이 변경되면 클라이언트에서 변경이 일어남" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="7620" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-14" value="RPC 원격 프로시저 호출 - 함수를 멀티 캐스트 RPC 로 지정하면 , 해당 액터가 복제된 모든 클라이언트에게 메세지를 보내서 , 해당 함수를 호출해야 함을 알립니다. 서버 및 클라이언트에 선언 가능합니다." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="7720" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-15" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="55" y="7890" width="980" height="526.75" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-16" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="78" y="8400" width="962" height="62.53" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-17" value="Ownership&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="72.5" y="8600" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-18" value="Player Controller 와 특별한 연결점이 있다." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="72.5" y="8698" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-19" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="89.98" y="8890" width="676.04" height="280" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-20" value="UNetConnection 은 기본적으로 UPlayer 를 나태낸다." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="72.5" y="8810" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-21" value="플레이어가 게임에 완전히 로그인 하면 해당 Player 와 연결된 PlayerController 액터가 생성됩니다." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="75" y="9220" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-22" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="78" y="9320" width="781.58" height="170" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-23" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="75" y="9520" width="660.54" height="300" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-25" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="60" y="9910" width="930" height="375.88" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-26" value="P1 에서 weapon 을 생성 했다 가정 -&amp;gt; 해당 액터의 Owner 참조 체인을 따라가다 보면 P1 이 생성 했다는 걸 알 수있다." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="10300" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2t_GcvDTFZOb7565rsNX-27" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="65" y="10521" width="970" height="518.14" as="geometry" />
        </mxCell>
