        <mxCell id="rDn9xJna2rlMll7MN2rU-101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="rDn9xJna2rlMll7MN2rU-100" target="rDn9xJna2rlMll7MN2rU-98" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rDn9xJna2rlMll7MN2rU-100" value="&lt;pre&gt;&lt;code&gt;마지막으로 새로 스폰된 Actor라면&lt;/code&gt;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="4360" y="16030" width="322" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rDn9xJna2rlMll7MN2rU-103" value="&lt;pre&gt;클라이언트에서 Actor 를 생성 하면 동기화가 안된다.&lt;br/&gt;Server RPC는 보통 서버도 알고 있고, 클라이언트가 소유한 Actor에서 호출해야 합니다. &lt;br/&gt;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="3684" y="15850" width="546" height="60" as="geometry" />
        </mxCell>
        <mxCell id="yTMjMVW8oUTsrAHUqKRr-1" value="&lt;pre&gt;&lt;code&gt;Connection-&amp;gt;PackageMap&lt;/code&gt;은 &lt;strong&gt;UObject 포인터를 네트워크용 NetGUID로 바꾸고, &lt;/strong&gt;&lt;/pre&gt;&lt;pre&gt;&lt;strong&gt;NetGUID를 다시 로컬 UObject로 복원하는 변환기&lt;/strong&gt;입니다.&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="3460" y="16070" width="546" height="60" as="geometry" />
        </mxCell>
        <mxCell id="yTMjMVW8oUTsrAHUqKRr-2" value="Connection-&gt;PackageMap-&gt;SerializeNewActor(Bunch, this, Actor);&#xa;Actor-&gt;OnSerializeNewActor(Bunch);" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="3340" y="16210" width="390" height="50" as="geometry" />
        </mxCell>
        <mxCell id="yTMjMVW8oUTsrAHUqKRr-3" value="[서버]&#xa;이 ActorChannel이 어떤 Actor를 위한 채널인지 기록&#xa;Actor NetGUID 기록&#xa;동적 Actor면 Archetype/Class, Level, Transform, Velocity 등 생성 정보 기록&#xa;추가 초기 생성 데이터가 있으면 OnSerializeNewActor로 기록" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="3340" y="16290" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="yTMjMVW8oUTsrAHUqKRr-4" value="Actor = World-&gt;SpawnActorAbsolute(&#xa;    Archetype-&gt;GetClass(),&#xa;    FTransform(Rotation, SpawnLocation),&#xa;    SpawnInfo&#xa;);&#xa;GuidCache-&gt;RegisterNetGUID_Client(NetGUID, Actor);" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="3920" y="16195.9" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="yTMjMVW8oUTsrAHUqKRr-5" value="[클라이언트]&#xa;NetGUID 읽기&#xa;이미 있는 Actor면 찾기&#xa;동적 Actor면 SpawnActorAbsolute로 생성&#xa;NetGUID &lt;-&gt; Actor 매핑 등록" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="3920" y="16320" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="yTMjMVW8oUTsrAHUqKRr-6" value="ActorChannelPool&#xa;  = 닫힌 ActorChannel 재사용 풀&#xa;&#xa;&#xa;SendBunch&#xa;  = Channel bunch를 Connection SendBuffer에 싣는 단계&#xa;&#xa;&#xa;실제 패킷 송신&#xa;  = UNetConnection::FlushNet -&gt; UIpConnection::LowLevelSend -&gt; Socket::SendTo&#xa;&#xa;&#xa;PackageMap&#xa;  = UObject 포인터와 NetGUID 사이의 번역기&#xa;&#xa;&#xa;SerializeNewActor&#xa;  = 새 ActorChannel의 Actor 정체성과 생성 정보를 쓰거나 읽는 함수&#xa;&#xa;&#xa;OnSerializeNewActor&#xa;  = Actor별 추가 생성 데이터를 bunch에 얹는 훅" style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="3475.5" y="16450" width="480" height="340" as="geometry" />
        </mxCell>
        <mxCell id="yTMjMVW8oUTsrAHUqKRr-7" value="&lt;pre&gt;Game Mode 는 서버에 하나 있다.&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="3684" y="15940" width="215" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
