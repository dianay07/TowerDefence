        <mxCell id="CNrmBwoxl9Gnr_lOSToc-12" value="Connection-&amp;gt;ReceivedRawPacket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
