          <mxGeometry x="5341.5" y="5227" width="446" height="60" as="geometry" />
        </mxCell>
        <mxCell id="CNrmBwoxl9Gnr_lOSToc-43" value="&lt;div&gt;PacketSequenceDelta &amp;gt; 0&lt;/div&gt;&lt;div&gt;→ 아직 처리하지 않은 새 패킷&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;PacketSequenceDelta &amp;lt;= 0&lt;/div&gt;&lt;div&gt;→ 이미 처리했거나 너무 오래된 패킷&lt;/div&gt;&lt;div&gt;→ 버림&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
