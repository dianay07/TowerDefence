        <mxCell id="fw3aHcV3YnYw64P1rIhG-32" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;div&gt;ReadPropertyHandle(Params);&lt;/div&gt;&lt;div&gt;ReceiveProperties_r(Params, StackParams);&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="5383" y="9335" width="307" height="53" as="geometry" />
