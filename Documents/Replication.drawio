        <mxCell id="rDn9xJna2rlMll7MN2rU-7" value="Listen Server Process&#xa;  UWorld&#xa;    NetDriver = GameNetDriver&#xa;      ServerConnection = nullptr&#xa;      ClientConnections[0] = Client1과의 연결&#xa;      ClientConnections[1] = Client2와의 연결&#xa;      ClientConnections[2] = Client3과의 연결&#xa;&#xa;&#xa;Client1 Process&#xa;  UWorld&#xa;    NetDriver = GameNetDriver&#xa;      ServerConnection = ListenServer와의 연결&#xa;      ClientConnections = empty&#xa;&#xa;&#xa;Client2 Process&#xa;  UWorld&#xa;    NetDriver = GameNetDriver&#xa;      ServerConnection = ListenServer와의 연결&#xa;&#xa;&#xa;Client3 Process&#xa;  UWorld&#xa;    NetDriver = GameNetDriver&#xa;      ServerConnection = ListenServer와의 연결" style="text;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
