        <mxCell id="CNrmBwoxl9Gnr_lOSToc-45" value="UNetConnection::DispatchPacket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="4996" y="5737" width="446" height="60" as="geometry" />
        </mxCell>
        <mxCell id="CNrmBwoxl9Gnr_lOSToc-47" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;box-sizing: border-box; border: 0px solid; margin: 0px; padding: 1px 6px; -webkit-box-decoration-break: clone; box-decoration-break: clone; background: none 0% 0% / auto repeat scroll padding-box border-box color(srgb 0.833766 0.833766 0.833766 / 0.0905882); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; overflow-wrap: anywhere; word-break: break-word; border-radius: 6px; font-size: 0.92em; display: inline; text-align: start;&quot; class=&quot;inline-markdown _inlineMarkdown_1ni73_357&quot;&gt;PacketNotify&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 13px; text-align: start;&quot;&gt;는&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; border: 0px solid; margin: 0px; padding: 0px; font-weight: 600; --tw-font-weight: 600; font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 13px; text-align: start;&quot; class=&quot;font-semibold&quot;&gt;패킷 단위의 순서 번호와 ACK/NACK 상태를 관리하는 객체&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 13px; text-align: start;&quot;&gt;야.&lt;/span&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="5370" y="5387" width="446" height="60" as="geometry" />
        </mxCell>
        <mxCell id="CNrmBwoxl9Gnr_lOSToc-48" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 11.04px;&quot;&gt;&lt;font face=&quot;Consolas, Courier New, monospace&quot;&gt;ACK - 정상수신/처리 , NACK - 못 받았거나 처리되지 않았음&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="5880" y="5387" width="446" height="60" as="geometry" />
        </mxCell>
        <mxCell id="CNrmBwoxl9Gnr_lOSToc-49" value="&lt;div style=&quot;text-align: left;&quot;&gt;PacketNotify&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;= 패킷 순서, ACK/NACK, 손실 여부를 관리하는 객체&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;첨부 코드 (&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;PacketSequenceDelta&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;&amp;nbsp; 관련 부분 )&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;= 받은 패킷이 새 패킷인지 확인&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;= 순서가 꼬였으면 캐시에 저장&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;= 상대가 알려준 ACK/NACK 처리&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;= InPacketId 갱신&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;= 오래된 패킷이면 버림&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;= 정상 패킷이면 이후 Bunch 처리 단계로 진행&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="5360" y="5477" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="CNrmBwoxl9Gnr_lOSToc-75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="CNrmBwoxl9Gnr_lOSToc-50" target="CNrmBwoxl9Gnr_lOSToc-52" edge="1">
